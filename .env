# Backend server port
PORT=5000

# Local MySQL database URL. Replace user, password and database name as needed.
DATABASE_URL=mysql://root:password@127.0.0.1:3306/ocms_db

# JWT secret used to sign access tokens — MUST be set to a strong random value (min 64 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=54806e6c9650fb1944b14c4ee99f29e27427bb7b47eed9b0771d0d7e709ad41ed7814ce612bb192a58c486131b5952fc8dff3cebd3d65d2149cf277ab2ce3600

# Separate secret for refresh token signing — MUST differ from JWT_SECRET (min 64 chars)
JWT_REFRESH_SECRET=91be17c5f01271181df7c0a56e6a89c46a358166d82ceb6542037ffd303d9ebdd48e5057e476b56ac7065438762de23e6ee4e358877a931e2a089c75d523e7f7
JWT_EXPIRES_IN=1d

# Comma-separated allowed CORS origins for the frontend (no trailing slashes)
CORS_ORIGIN=http://localhost:3000

# Ensure Prisma uses the library engine. Do NOT wrap the value in quotes.
PRISMA_CLIENT_ENGINE_TYPE=library

# Environment: development | production | test
NODE_ENV=development