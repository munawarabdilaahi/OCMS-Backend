PORT=5000
DATABASE_URL=mysql://root:changeme@127.0.0.1:3306/ocms_db
JWT_SECRET=replace-with-a-strong-random-secret-at-least-64-chars
JWT_REFRESH_SECRET=replace-with-a-different-strong-random-secret-at-least-64-chars
JWT_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:3000
PRISMA_CLIENT_ENGINE_TYPE=library
NODE_ENV=development
# Base URL used to build password-reset and email-verification links
FRONTEND_URL=http://localhost:3000
# Optional HTTP mail-delivery endpoint. When set, reset/verify emails are POSTed
# as JSON { from, to, subject, text, html }. When empty, emails are logged only
# (dev fallback) and the auth flow continues without error.
MAILER_HTTP_URL=
MAILER_FROM=no-reply@ocms.local
