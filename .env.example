NODE_ENV=development
PORT=5000

# Prisma database connection (MySQL)
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/ocms

# Authentication — generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-strong-random-secret-at-least-64-chars

# Refresh token secret — MUST be different from JWT_SECRET
JWT_REFRESH_SECRET=replace-with-a-different-strong-random-secret-at-least-64-chars
JWT_EXPIRES_IN=1d

# Comma-separated frontend origins allowed to call the API
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
